# Base URL of the TKP Hub API. With mocks on, MSW answers requests under this path.
VITE_API_BASE_URL=/api/v1
# true = use the in-browser mock API (MSW). Set to false when pointing at the real backend.
VITE_USE_MOCKS=true
# true = show the developer UI kit (/dev/ui) in the sidebar. Only works with mocks on.
VITE_SHOW_UI_KIT=false
